# The build context is the whole repo; keep out everything the image does not
# need, so builds are fast and the layer cache stays warm.
.git
.gitignore
.venv
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
.mypy_cache

# The frontend sources and toolchain: only the *built* dashboard under
# app/static/dashboard is needed, and that is committed.
Frontend/node_modules
Frontend/dist
Frontend/.vite

# Local-only files
.env
*.log
Dockerfile
.dockerignore
README.md
docs
