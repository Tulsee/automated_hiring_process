MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=hiring_db

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=candidates

EMBEDDING_DIMENSION=768

# Where Ollama is reachable. Left unset the client uses localhost:11434; in
# Docker Compose the app service sets this to http://ollama:11434.
# OLLAMA_HOST=http://127.0.0.1:11434

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# email configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com


QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=candidates
EMBED_MODEL=nomic-embed-text

# Where the candidate-facing interview page is reachable. Invite links in
# emails are built from this, so it must match the port you actually serve on.
APP_BASE_URL=http://127.0.0.1:8000

# How long an interview invite link stays usable
INTERVIEW_INVITE_TTL_HOURS=72

# Speech-to-text (tiny | base | small | medium); larger is slower on CPU
WHISPER_MODEL=base

# Model used to score interview answers against the rubric
SCORING_MODEL=qwen3.5:4b

# --- Authentication -------------------------------------------------------
# The signing key for session tokens (JWT). Change it for any real
# deployment; sessions are forgeable if this is left at the default.
JWT_SECRET=change-me-to-a-long-random-string
# How long a sign-in lasts, in minutes (default 12 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=720
# The first administration account, created on startup when it is absent.
# Leave the password empty to skip bootstrapping (no superadmin is created).
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=Qwerty@123
SUPERADMIN_NAME=Super Admin

# --- Observability (LangSmith tracing) ------------------------------------
# Off by default, so the app runs with no account. Turn it on to replay every
# prompt and score in the LangSmith UI (Module 19).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=automated-hiring
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
