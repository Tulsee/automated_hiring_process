MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=hiring_db

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=candidates

EMBEDDING_DIMENSION=768

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# email configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com


QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=candidates
EMBED_MODEL=nomic-embed-text

# Where the candidate-facing interview page is reachable. Invite links in
# emails are built from this, so it must match the port you actually serve on.
APP_BASE_URL=http://127.0.0.1:8000

# How long an interview invite link stays usable
INTERVIEW_INVITE_TTL_HOURS=72

# Speech-to-text (tiny | base | small | medium); larger is slower on CPU
WHISPER_MODEL=base

# Model used to score interview answers against the rubric
SCORING_MODEL=qwen3.5:4b
